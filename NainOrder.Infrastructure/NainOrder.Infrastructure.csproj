<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Referencia directa para forzar la version parcheada: la que arrastra EF Core
         (2.1.11) tiene una vulnerabilidad conocida de gravedad alta. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NainOrder.Application\NainOrder.Application.csproj" />
    <ProjectReference Include="..\NainOrder.Domain\NainOrder.Domain.csproj" />
  </ItemGroup>

</Project>
